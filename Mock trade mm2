local function generateRandomFullInventory()
    local inv = {
        Weapons = {
            Owned = {},
            Equipped = {
                Knife = "DefaultKnife",
                Gun = "DefaultGun"
            }
        },
        Effects = {
            Owned = {},
            Equipped = {}
        },
        Perks = {
            Owned = {},
            Equipped = {}
        },
        Emotes = {
            Owned = {},
            Equipped = {}
        },
        Radios = {
            Owned = {},
            Equipped = {}
        },
        Pets = {
            Owned = {},
            Equipped = {}
        },
        Uniques = {}
    }

    local function collectKeys(tbl)
        local keys = {}
        for id, data in pairs(tbl) do
            if typeof(data) == "table" and (data.ItemName or data.Name) then
                table.insert(keys, id)
            end
        end
        return keys
    end

    local function pickRandom(keys, min, max)
        local picked = {}
        local count = math.random(min, math.min(max, #keys))
        for _ = 1, count do
            if #keys == 0 then
                break
            end
            local pick = math.random(1, #keys)
            table.insert(picked, keys[pick])
            table.remove(keys, pick)
        end
        return picked
    end

    -- Weapons
    local wKeys = {}
    for id, data in pairs(Sync.Weapons) do
        if id ~= "DefaultKnife" and id ~= "DefaultGun" and typeof(data) == "table" and (data.ItemName or data.Name) then
            table.insert(wKeys, id)
        end
    end
    for _, id in ipairs(pickRandom(wKeys, 5, 20)) do
        inv.Weapons.Owned[id] = math.random(1, 3)
    end

    -- Effects
    if Sync.Effects then
        for _, id in ipairs(pickRandom(collectKeys(Sync.Effects), 2, 8)) do
            table.insert(inv.Effects.Owned, id)
        end
    end
    -- Perks
    if Sync.Perks then
        for _, id in ipairs(pickRandom(collectKeys(Sync.Perks), 1, 5)) do
            table.insert(inv.Perks.Owned, id)
        end
    end
    -- Emotes
    if Sync.Emotes then
        for _, id in ipairs(pickRandom(collectKeys(Sync.Emotes), 2, 6)) do
            table.insert(inv.Emotes.Owned, id)
        end
    end
    -- Radios
    if Sync.Radios then
        for _, id in ipairs(pickRandom(collectKeys(Sync.Radios), 1, 4)) do
            table.insert(inv.Radios.Owned, id)
        end
    end
    -- Pets
    if Sync.Pets then
        for _, id in ipairs(pickRandom(collectKeys(Sync.Pets), 1, 6)) do
            inv.Pets.Owned[id] = math.random(1, 2)
        end
    end

    return inv
end

getFakeProfileData = function(playerName)
    if not fakeProfileCache[playerName] or not fakeProfileCache[playerName].profile then
        local existingAvatar = fakeProfileCache[playerName] and fakeProfileCache[playerName].avatarImage
        fakeProfileCache[playerName] = {
            profile = generateRandomInventory(playerName),
            inventory = generateRandomFullInventory(),
            avatarImage = existingAvatar
        }
        if not fakeProfileCache[playerName].avatarImage then
