                usernameLabel.Text = p9
            end

            local levelFrame = character and character.CharacterIcon:FindFirstChild("LevelFrame")
            if levelFrame then
                local levelContainer = levelFrame:FindFirstChild("LevelContainer")
                if levelContainer then
                    local icon = levelContainer:FindFirstChild("Icon")
                    if icon and icon:FindFirstChild("Level") then
                        icon.Level.Text = profileData.Level
                    end
                    local prestige = levelContainer:FindFirstChild("Prestige")
                    if prestige then
                        prestige.Visible = profileData.Prestige > 0
                        if profileData.Prestige > 0 then
                            prestige.Text = romanNumerals[profileData.Prestige] or ""
                        end
                    end
                end
            end

            if character then
                if character:FindFirstChild("Elite") then
                    character.Elite.Visible = profileData.Elite == true
                end
                if character:FindFirstChild("Builder") then
                    character.Builder.Visible = profileData.MapBuilder == true
                end
                if character:FindFirstChild("WeaponDesigner") then
                    character.WeaponDesigner.Visible = profileData.WeaponDesigner == true
                end
                if character:FindFirstChild("MM2Creator") then
                    character.MM2Creator.Visible = profileData.Nikilis == true
                end
                if character:FindFirstChild("BetaTester") then
                    character.BetaTester.Visible = profileData.BetaTester == true
                end
                if character:FindFirstChild("Clown") then
                    character.Clown.Visible = profileData.Clown == true
                end
            end

            local statsContainer = profileContainer:FindFirstChild("Profile")
            if statsContainer then
                local s1 = statsContainer:FindFirstChild("Season1Stats")
                if s1 and s1:FindFirstChild("Container") then
                    local c = s1.Container
                    if c:FindFirstChild("Eliminations") then
                        c.Eliminations.Amount.Text = profileData.Eliminations
                    end
                    if c:FindFirstChild("Saves") then
                        c.Saves.Amount.Text = profileData.Victories
                    end
                    if c:FindFirstChild("Survivals") then
                        c.Survivals.Amount.Text = profileData.Survivals
                    end
                end
                local trophies = statsContainer:FindFirstChild("Trophies")
                if trophies then
                    trophies.Visible = false
                end
            end

            if p8 and p8:FindFirstChild("Nav") then
                local navProfile = p8.Nav:FindFirstChild("Profile")
                if navProfile and navProfile:FindFirstChild("Icon") then
                    navProfile.Icon.Image = cached.avatarImage or ""
                end
            end
        end
        ViewProfileModule.DisplayInventoryFake(p8, p9, cached.inventory, p11)
        return
    end
    return origGenerateProfile(p8, p9, p10, p11)
end

ViewProfileModule.DisplayInventoryFake = function(p26, p27, fakeInv, p28)
    local InventoryModuleRef = require(ReplicatedStorage.Modules.InventoryModule)
    for _, category in pairs({"Weapons", "Effects", "Perks", "Emotes", "Radios", "Pets"}) do
        local catFrame = p26.Main:FindFirstChild(category)
        if catFrame then
            local titleFrame = catFrame:FindFirstChild("Title")
            if titleFrame then
                titleFrame.Username.Text = p27 .. "'s " .. category
            end
            for tabName, _ in pairs(InventoryModuleRef.CreateBlankInventoryTable()[category]) do
                local tabContainer = catFrame.Items.Container:FindFirstChild(tabName) or
                                         (catFrame.Items.Container:FindFirstChild("Holiday") and
                                             catFrame.Items.Container.Holiday.Container:FindFirstChild(tabName))
                if tabContainer and tabContainer:FindFirstChild("Container") then
                    tabContainer.Container:ClearAllChildren()
                end
            end
        end
    end
    local generated = InventoryModuleRef.GenerateInventory(p26, fakeInv, nil, p28)
    ViewProfileModule.PlayerInventories[p27] = generated
end

