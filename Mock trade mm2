local function findItemByName(input)
    local lower = input:lower()
    if Sync.Weapons[input] then
        return input, "Weapons"
    end
    if Sync.Pets and Sync.Pets[input] then
        return input, "Pets"
    end

    for k, _ in pairs(Sync.Weapons) do
        if k:lower() == lower then
            return k, "Weapons"
        end
    end
    if Sync.Pets then
        for k, _ in pairs(Sync.Pets) do
            if k:lower() == lower then
                return k, "Pets"
            end
        end
    end

    for k, v in pairs(Sync.Weapons) do
        if typeof(v) == "table" then
            local displayName = v.ItemName or v.Name or ""
            if displayName:lower() == lower then
                return k, "Weapons"
            end
        end
    end
    if Sync.Pets then
        for k, v in pairs(Sync.Pets) do
            if typeof(v) == "table" then
                local displayName = v.ItemName or v.Name or ""
                if displayName:lower() == lower then
                    return k, "Pets"
                end
            end
        end
    end

    for k, v in pairs(Sync.Weapons) do
        if typeof(v) == "table" then
            local displayName = v.ItemName or v.Name or ""
            if string.find(displayName:lower(), lower) then
                return k, "Weapons"
            end
        end
    end
    if Sync.Pets then
        for k, v in pairs(Sync.Pets) do
            if typeof(v) == "table" then
                local displayName = v.ItemName or v.Name or ""
                if string.find(displayName:lower(), lower) then
                    return k, "Pets"
                end
            end
        end
    end

    return nil, nil
end

