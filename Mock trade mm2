startFakeTrade = function(playerName)
    fakeTradeName = playerName
    fakeTradeActive = true
    -- Disable game's accept handlers during fake trade
    if not originalAcceptConns then
        local acceptBtn = TradeActions.Accept:FindFirstChild("ActionButton")
        if acceptBtn then
            originalAcceptConns = getconnections(acceptBtn.MouseButton1Click)
            for _, conn in ipairs(originalAcceptConns) do
                conn:Disable()
            end
        end
    end
    fakeTheirOffer = {}
    fakeYourOffer = {}
    TradeModule.GUI.TradeGUI = TradeGUI
    TradeModule.GUI.Actions = TradeActions
    TradeModule.GUI.YourOffer = YourOffer
    TradeModule.GUI.TheirOffer = TheirOffer

    local itemsFrame = TradeContainer:FindFirstChild("Items")
    if itemsFrame then
        local mf = itemsFrame:FindFirstChild("Main")
        if mf then
            for _, category in pairs({"Weapons", "Pets"}) do
                local catFrame = mf:FindFirstChild(category)
                if catFrame then
                    local container = catFrame:FindFirstChild("Items") and catFrame.Items:FindFirstChild("Container")
                    if container then
                        for _, tab in pairs(container:GetChildren()) do
                            if tab:FindFirstChild("Container") then
                                tab.Container:ClearAllChildren()
                            end
                        end
                    end
                end
            end
        end
        TradeModule.TradeInventory = InventoryModule.GenerateInventory(itemsFrame, ProfileData, "Trading")
        TradeModule.ConnectOfferButtons(TradeModule.TradeInventory)
    end

    TradeGUI.Enabled = true
    if TradeGUI:FindFirstChild("ClickBlocker") then
        TradeGUI.ClickBlocker.Visible = false
    end
    TheirOffer.Username.Text = "(" .. playerName .. ")"
    refreshTradeDisplay()
    -- Reset accept confirmation state
    if TradeActions.Accept:FindFirstChild("Confirm") then
        TradeActions.Accept.Confirm.Visible = false
    end
    if TradeActions.Accept:FindFirstChild("Cancel") then
        TradeActions.Accept.Cancel.Visible = false
    end
    if TradeActions.Accept:FindFirstChild("AddItem") then
        TradeActions.Accept.AddItem.Visible = true  -- no items yet on open
    end
    -- Connect search bar
    local itemsFrame = TradeContainer:FindFirstChild("Items")
    if itemsFrame then
        local searchFrame = itemsFrame:FindFirstChild("Tabs") and itemsFrame.Tabs:FindFirstChild("Search")
        if searchFrame then
            local searchBox = searchFrame:FindFirstChild("Container") and
                                  searchFrame.Container:FindFirstChild("SearchText")
            if searchBox and TradeModule.TradeInventory then
                searchBox.Text = ""
                searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                    local query = string.lower(searchBox.Text)
                    for category, tabs in pairs(TradeModule.TradeInventory.Data) do
                        for _, items in pairs(tabs) do
                            for itemID, itemData in pairs(items) do
                                if itemData.Frame then
                                    if query == "" then
                                        itemData.Frame.Visible = true
                                    else
                                        local name = string.lower(itemData.Name or itemID)
                                        itemData.Frame.Visible = string.find(name, query) ~= nil
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end
    end
    -- Disconnect previous mock handlers if any
    if mockAcceptConn then
        mockAcceptConn:Disconnect()
    end
    if mockConfirmConn then
        mockConfirmConn:Disconnect()
    end
    if mockCancelConn then
        mockCancelConn:Disconnect()
    end

    -- Step 1: Accept button shows "Are you sure?" confirm
    mockAcceptConn = TradeActions.Accept.ActionButton.MouseButton1Click:Connect(function()
        if not fakeTradeActive then
            return
        end
        if fakeAcceptCooldown > 0 then
            return
        end
        -- FIX: Don't allow accepting with no items on either side
        if #fakeYourOffer == 0 and #fakeTheirOffer == 0 then
            return
        end
        TradeActions.Accept.Confirm.Visible = true
    end)

    -- Step 2: Confirm button actually accepts
    local confirmBtn = TradeActions.Accept:FindFirstChild("Confirm")
    if confirmBtn then
        local confirmActionBtn = confirmBtn:FindFirstChild("ActionButton")
        if confirmActionBtn then
            if mockConfirmConn then
                mockConfirmConn:Disconnect()
            end
            mockConfirmConn = confirmActionBtn.MouseButton1Click:Connect(function()
                if not fakeTradeActive then
                    return
                end
                if fakeAcceptCooldown > 0 then
                    return
                end
                -- FIX: Don't allow accepting with no items on either side
                if #fakeYourOffer == 0 and #fakeTheirOffer == 0 then
                    return
                end

                YourOffer.Accepted.Visible = true
                -- ... rest of code
                TradeActions.Accept.Confirm.Visible = false
                if TradeActions.Accept:FindFirstChild("Cancel") then
                    TradeActions.Accept.Cancel.Visible = true
                end

                task.delay(fakeAcceptDelay, function()
                    if not fakeTradeActive or not YourOffer.Accepted.Visible then
                        return
                    end
                    TheirOffer.Accepted.Visible = true
                    task.delay(0.5, function()
                        if not fakeTradeActive or not YourOffer.Accepted.Visible then
                            return
                        end
                        lastTradePartner = fakeTradeName
                        recentLabel.Text = fakeTradeName
                        print("[MockTrade] Trade completed!")
                        print("[MockTrade] You gave:", #fakeYourOffer, "items")
                        print("[MockTrade] You received:", #fakeTheirOffer, "items")

                        for _, receivedItem in ipairs(fakeTheirOffer) do
                            ItemPopupService:AddNewItem(receivedItem.ItemID, receivedItem.ItemType, receivedItem.Amount)
                        end

                        setthreadidentity(2)
                        for _, receivedItem in ipairs(fakeTheirOffer) do
                            local category = receivedItem.ItemType
                            if category == "Weapons" then
                                for _ = 1, (receivedItem.Amount or 1) do
                                    ProfileData[category].Owned[receivedItem.ItemID] =
                                        (ProfileData[category].Owned[receivedItem.ItemID] or 0) + 1
                                end
                                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                                if remotes then
                                    local inv = remotes:FindFirstChild("Inventory")
                                    if inv then
                                        local changed = inv:FindFirstChild("InventoryDataChanged")
                                        if changed then
                                            changed:Fire(category, receivedItem.ItemID,
                                                ProfileData[category].Owned[receivedItem.ItemID])
                                        end
                                    end
                                end
                            elseif category == "Pets" then
                                ProfileData[category].Owned[receivedItem.ItemID] =
                                    (ProfileData[category].Owned[receivedItem.ItemID] or 0) + (receivedItem.Amount or 1)
                            end
                        end
                        setthreadidentity(8)

                        for _, givenItem in ipairs(fakeYourOffer) do
                            local category = givenItem.ItemType
                            if category == "Weapons" or category == "Pets" then
                                local owned = ProfileData[category].Owned
                                if owned[givenItem.ItemID] then
                                    owned[givenItem.ItemID] = owned[givenItem.ItemID] - (givenItem.Amount or 1)
                                    if owned[givenItem.ItemID] <= 0 then
                                        owned[givenItem.ItemID] = nil
                                    end
                                end
                            end
                        end
                        closeFakeTrade()
                    end)
                end)
            end)
        end
    end

    if TradeActions.Accept:FindFirstChild("Cancel") then
        mockCancelConn = TradeActions.Accept.Cancel.ActionButton.MouseButton1Click:Connect(function()
            if not fakeTradeActive then
                return
            end
            YourOffer.Accepted.Visible = false
            TheirOffer.Accepted.Visible = false
            if TradeActions.Accept:FindFirstChild("Cancel") then
                TradeActions.Accept.Cancel.Visible = false
            end
        end)
    end
    print("[MockTrade] Fake trade started with: " .. playerName)
end

closeFakeTrade = function()
    fakeTradeActive = false
    fakeTradeName = nil
    fakeTheirOffer = {}
    fakeYourOffer = {}
    TradeGUI.Enabled = false
    if TradeGUI:FindFirstChild("ClickBlocker") then
        TradeGUI.ClickBlocker.Visible = false
    end
    -- Disconnect mock handlers
    if mockAcceptConn then
        mockAcceptConn:Disconnect();
        mockAcceptConn = nil
    end
    if mockConfirmConn then
        mockConfirmConn:Disconnect();
        mockConfirmConn = nil
    end
    if mockCancelConn then
        mockCancelConn:Disconnect();
        mockCancelConn = nil
    end
    -- Re-enable game's accept handlers for real trades
    if originalAcceptConns then
        for _, conn in ipairs(originalAcceptConns) do
            conn:Enable()
        end
        originalAcceptConns = nil
    end
    TradeModule.TradeInventory = nil

    -- Queue next auto trade if enabled
    if autoTradeEnabled then
        task.delay(autoTradeDelay, function()
            if autoTradeEnabled and not fakeTradeActive and not fakeRequestActive then
                showRandomTradeRequest()
            end
        end)
    end
end

