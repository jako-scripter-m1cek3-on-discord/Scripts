local function populateDropdown()
    for _, child in pairs(dropdownScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local playerList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playerList, player.Name)
        end
    end
    for name, _ in pairs(fakePlayerFrames) do
        local found = false
        for _, n in ipairs(playerList) do
            if n == name then found = true; break end
        end
        if not found then
            table.insert(playerList, name)
        end
    end

    table.sort(playerList, function(a, b)
        local aVal = playerValueCache[a] or 0
        local bVal = playerValueCache[b] or 0
        return aVal > bVal
    end)

    for i, name in ipairs(playerList) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 24)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
        btn.BorderSizePixel = 0
        local cached = playerValueCache[name]
        btn.Text = cached
            and string.format("  %s  -  %s", truncate(name, 12), formatValue(cached))
            or  string.format("  %s  -  ...", truncate(name, 12))
        btn.TextColor3 = Color3.fromRGB(220, 220, 230)
        btn.TextSize = 11
        btn.Font = Enum.Font.Gotham
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.LayoutOrder = cached and -cached or i
        btn.Parent = dropdownScroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            lastTradePartner = name
            recentLabel.Text = name
            closeDropdown()
        end)
    end

    task.defer(function()
        dropdownHeight = math.min(dropdownLayout.AbsoluteContentSize.Y + 6, 150)
    end)
end

