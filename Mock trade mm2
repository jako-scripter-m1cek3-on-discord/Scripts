-- 10. Respawn / Re-injection
-------------------------------------------------
local reinjecting = false

local function reinjectAll()
    if reinjecting then
        return
    end
    reinjecting = true
    local freshGUI = PlayerGui:FindFirstChild("MainGUI")
    if freshGUI then
        local freshLB = freshGUI:FindFirstChild("Game") and freshGUI.Game:FindFirstChild("Leaderboard")
        if freshLB then
            Leaderboard = freshLB
            LeaderboardContainer = freshLB:FindFirstChild("Container") or freshLB:WaitForChild("Container")
        end
    end
    for name, data in pairs(fakePlayerData) do
        if not LeaderboardContainer:FindFirstChild("FAKE_" .. name) then
            fakePlayerFrames[name] = nil
            origAddFakePlayer(name, data.level, data.prestige, data.isElite)
        end
    end
    sortLeaderboard()
    reinjecting = false
end

local function setupChildRemovedListener()
    LeaderboardContainer.ChildRemoved:Connect(function(child)
        if string.find(child.Name, "FAKE_") then
            local fakeName = string.sub(child.Name, 6)
            if fakePlayerData[fakeName] then
                local currentGUI = PlayerGui:FindFirstChild("MainGUI")
                if currentGUI then
                    local currentLB = currentGUI:FindFirstChild("Game") and
                                          currentGUI.Game:FindFirstChild("Leaderboard")
                    if currentLB and currentLB:FindFirstChild("Container") == LeaderboardContainer then
                        task.defer(reinjectAll)
                    end
                end
            end
        end
    end)
end

setupChildRemovedListener()

LocalPlayer.CharacterAdded:Connect(function()
    local freshGUI
    repeat
        freshGUI = PlayerGui:FindFirstChild("MainGUI")
        if freshGUI then
            local freshLB = freshGUI:FindFirstChild("Game") and freshGUI.Game:FindFirstChild("Leaderboard")
            if freshLB and freshLB:FindFirstChild("Container") then
                local hasPlayerFrame = false
                for _, child in pairs(freshLB.Container:GetChildren()) do
                    if child:FindFirstChild("IsPlayerFrame") then
                        hasPlayerFrame = true;
                        break
                    end
                end
                if hasPlayerFrame then
                    break
                end
            end
        end
        task.wait()
    until false

    reinjectAll()
    setupChildRemovedListener()

    local newInspect = Leaderboard:FindFirstChild("Inspect")
    if newInspect and newInspect:FindFirstChild("Container") then
        local newTradeBtn = newInspect.Container:FindFirstChild("Trade")
        if newTradeBtn then
            newTradeBtn.MouseButton1Click:Connect(function()
                local targetName = newInspect.Container.Username.Text
                if fakePlayerFrames[targetName] then
                    newInspect.Visible = false
                    startFakeTradeRequest(targetName)
                end
            end)
        end
    end
end)

ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Inventory"):WaitForChild("UpdateLeaderboard").OnClientEvent:Connect(
    function()
        task.defer(reinjectAll)
    end)

