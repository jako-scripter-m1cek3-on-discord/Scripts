startAcceptCooldown = function()
    fakeAcceptCooldown = 6
    local cooldownFrame = TradeActions.Accept:FindFirstChild("Cooldown")
    if cooldownFrame then
        cooldownFrame.Visible = true
        if cooldownFrame:FindFirstChild("Title") then
            cooldownFrame.Title.Text = " Please wait (" .. fakeAcceptCooldown .. ") before accepting."
        end
    end
    if fakeAcceptCoolingDown then
        fakeAcceptCooldown = 6;
        return
    end
    fakeAcceptCoolingDown = true
    task.spawn(function()
        while fakeAcceptCooldown > 0 and fakeTradeActive do
            task.wait(1)
            fakeAcceptCooldown = fakeAcceptCooldown - 1
            if cooldownFrame and cooldownFrame:FindFirstChild("Title") then
                cooldownFrame.Title.Text = " Please wait (" .. fakeAcceptCooldown .. ") before accepting."
            end
        end
        fakeAcceptCoolingDown = false
        if cooldownFrame then
            cooldownFrame.Visible = false
        end
    end)
end

