local function updateTradeInventoryDisplay()
    if not TradeModule.TradeInventory then
        return
    end
    for category, tabs in pairs(TradeModule.TradeInventory.Data) do
        for _, items in pairs(tabs) do
            for itemID, itemData in pairs(items) do
                local frame = itemData.Frame
                if frame then
                    local baseAmount = itemData.Amount
                    for _, offered in ipairs(fakeYourOffer) do
                        if offered.ItemID == itemID and offered.ItemType == category then
                            baseAmount = baseAmount - (offered.Amount or 1)
                        end
                    end
                    if baseAmount > 1 then
                        frame.Container.Amount.Text = "x" .. baseAmount
                        frame.Visible = true
                    elseif baseAmount == 1 then
                        frame.Container.Amount.Text = ""
                        frame.Visible = true
                    else
                        frame.Visible = false
                    end
                end
            end
        end
    end
end

local function displayOfferItems(panel, offerTable)
    if offerSlotConnections[panel] then
        for _, conn in ipairs(offerSlotConnections[panel]) do
            conn:Disconnect()
        end
    end
    offerSlotConnections[panel] = {}
    for _, child in pairs(panel.Container:GetChildren()) do
        if child:IsA("Frame") then
            child.Visible = false
        end
    end
    for i, item in ipairs(offerTable) do
        local slot = panel.Container:FindFirstChild("NewItem" .. i)
        if slot then
            local itemData = {}
            local source = Sync[item.ItemType] and Sync[item.ItemType][item.ItemID]
            if source then
                for k, v in pairs(source) do
                    itemData[k] = v
                end
                itemData.DataType = item.ItemType
                itemData.Amount = item.Amount or 1
                ItemModule.DisplayItem(slot, itemData)
                slot.Visible = true
                if panel == YourOffer then
                    local actionBtn = slot:FindFirstChild("Container") and slot.Container:FindFirstChild("ActionButton")
                    if actionBtn then
                        local conn = actionBtn.MouseButton1Click:Connect(function()
                            if not fakeTradeActive then
                                return
                            end
                            for idx, offered in ipairs(fakeYourOffer) do
                                if offered.ItemID == item.ItemID and offered.ItemType == item.ItemType then
                                    if offered.Amount > 1 then
                                        offered.Amount = offered.Amount - 1
                                    else
                                        table.remove(fakeYourOffer, idx)
                                    end
                                    break
                                end
                            end
                            refreshTradeDisplay()
                            startAcceptCooldown()
                        end)
                        table.insert(offerSlotConnections[panel], conn)
                    end
                end
            end
        end
    end
end

