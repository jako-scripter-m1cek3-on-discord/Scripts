local function spawnItem(itemKey, category)
    setthreadidentity(2)
    local source = Sync[category]
    if not source or not source[itemKey] then
        setthreadidentity(8)
        return false
    end
    if evoItems[itemKey] and ProfileData[category].Owned[itemKey] then
        setthreadidentity(8)
        spawnStatusLabel.Text = "Already owned (Evo)"
        spawnStatusLabel.TextColor3 = Color3.fromRGB(200, 80, 80)
        return false
    end
    if evoItems[itemKey] then
        ProfileData[category].Owned[itemKey] = 1
    else
        ProfileData[category].Owned[itemKey] = (ProfileData[category].Owned[itemKey] or 0) + 1
    end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local inv = remotes:FindFirstChild("Inventory")
        if inv then
            local changed = inv:FindFirstChild("InventoryDataChanged")
            if changed then
                changed:Fire(category, itemKey, ProfileData[category].Owned[itemKey])
            end
        end
    end
    setthreadidentity(8)
    return true
end

function truncate(str, maxLen)
    if #str > maxLen then
        return str:sub(1, maxLen - 1) .. "…"
    end
    return str
end

local function updateDropdownEntry(name, val)
    if not dropdownScroll then return end
    for _, btn in ipairs(dropdownScroll:GetChildren()) do
        if btn:IsA("TextButton") and btn.Text:find(truncate(name, 12), 1, true) then
            btn.Text = string.format("  %s  -  %s", truncate(name, 12), formatValue(val))
            btn.LayoutOrder = -val
            break
        end
    end
end

local function fetchPlayerValues()
    valueFetchToken = valueFetchToken + 1
    local myToken = valueFetchToken

    task.spawn(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if myToken ~= valueFetchToken then return end

            local playerName = player.Name

            local ok, inv = pcall(function()
                return GetFullInventoryRemote:InvokeServer(playerName)
            end)
            if myToken ~= valueFetchToken then return end

            if ok and typeof(inv) == "table" then
                local total = calculateInventoryValue(inv)
                playerValueCache[playerName] = total

                -- update users tab row
                for _, row in ipairs(playerRows) do
                    if row:GetAttribute("PlayerRef") == playerName then
                        row.Text = string.format("  %s  -  %s",
                            truncate(playerName, 14), formatValue(total))
                        row.LayoutOrder = -total
                        break
                    end
                end

                -- update dropdown if open
                if dropdownOpen then
                    updateDropdownEntry(playerName, total)
                end
            else
                for _, row in ipairs(playerRows) do
                    if row:GetAttribute("PlayerRef") == playerName then
                        row.Text = string.format("  %s  -  err", truncate(playerName, 14))
                        break
                    end
                end
            end

            task.wait(0.4)
        end
        task.defer(rebuildUsersTab) -- add this line here
    end)
end

