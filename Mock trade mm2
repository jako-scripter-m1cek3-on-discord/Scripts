            if player ~= LocalPlayer then
                table.insert(playerList, player.Name)
            end
        end
        for name, _ in pairs(fakePlayerFrames) do
            local found = false
            for _, n in ipairs(playerList) do
                if n == name then found = true; break end
            end
            if not found then
                table.insert(playerList, name)
            end
        end
        table.sort(playerList, function(a, b)
            local aVal = playerValueCache[a] or 0
            local bVal = playerValueCache[b] or 0
            return aVal > bVal
        end)
        -- update existing buttons or repopulate if counts differ
        local existing = {}
        for _, btn in ipairs(dropdownScroll:GetChildren()) do
            if btn:IsA("TextButton") then
                table.insert(existing, btn)
            end
        end
        if #existing ~= #playerList then
            populateDropdown()
        else
            for i, name in ipairs(playerList) do
                local btn = existing[i]
                if btn then
                    local cached = playerValueCache[name]
                    btn.Text = cached
                        and string.format("  %s  -  %s", truncate(name, 12), formatValue(cached))
                        or  string.format("  %s  -  ...", truncate(name, 12))
                    btn.LayoutOrder = cached and -cached or i
                end
            end
        end
    end
end)

