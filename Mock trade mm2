    blockUserButton.TextSize = 11
    blockUserButton.Font = Enum.Font.GothamBold
    blockUserButton.LayoutOrder = math.huge -- always at top
    blockUserButton.Parent = usersScroll
    Instance.new("UICorner", blockUserButton).CornerRadius = UDim.new(0, 4)

    blockUserButton.MouseButton1Click:Connect(function()
        if not selectedUserName then
            warn("[MockTrade] No user selected.")
            return
        end
        local targetPlayer = Players:FindFirstChild(selectedUserName)
        if not targetPlayer then
            warn("[MockTrade] Player not in server.")
            return
        end
        blockUserButton.Text = "Blocking..."
        task.spawn(function()
            local ok = BlockPlayer(targetPlayer)
            blockUserButton.Text = ok and "Blocked!" or "Failed"
            task.wait(1.5)
            blockUserButton.Text = "Block Selected User"
        end)
    end)

    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(list, player.Name)
        end
    end

    table.sort(list, function(a, b)
        return (playerValueCache[a] or 0) > (playerValueCache[b] or 0)
    end)

    for i, name in ipairs(list) do
        local cached = playerValueCache[name]
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 24)
        row.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
        row.BorderSizePixel = 0
        row.Text = cached
            and string.format("  %s  -  %s", truncate(name, 14), formatValue(cached))
            or  string.format("  %s  -  ...", truncate(name, 14))
        row.TextColor3 = Color3.fromRGB(220, 220, 230)
        row.TextSize = 11
        row.Font = Enum.Font.Gotham
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.LayoutOrder = cached and -cached or i
        row:SetAttribute("PlayerRef", name)
        row.Parent = usersScroll
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)
        table.insert(playerRows, row)

        -- Re-highlight if this row is the currently selected one (after a rebuild)
        if selectedUserName == name then
            row.BackgroundColor3 = Color3.fromRGB(60, 90, 150)
            selectedUserRow = row
        end

        row.MouseButton1Click:Connect(function()
            if selectedUserRow == row then
                -- Second click on same row: confirm
                lastTradePartner = name
                recentLabel.Text = name
                selectedUserRow = nil
                selectedUserName = nil
                row.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                switchTab("Control")
            else
                -- First click: just select
                if selectedUserRow and selectedUserRow.Parent then
                    selectedUserRow.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                end
                selectedUserRow = row
                selectedUserName = name
                row.BackgroundColor3 = Color3.fromRGB(60, 90, 150)
            end
        end)
    end
end

