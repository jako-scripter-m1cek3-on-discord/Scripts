oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" then
        if self == realCancelRequest and fakeRequestActive then
            cancelFakeRequest()
            print("[MockTrade] Trade request cancelled (via remote).")
            return
        end
        if fakeTradeActive then
            if self == realOfferItem then
                local args = {...}
                local itemID = args[1]
                local itemType = args[2]
                if itemID == "DefaultKnife" or itemID == "DefaultGun" or itemID == "Synthwave_Godly" or itemID ==
                    "IceHammer_Godly" or itemID == "Gingerscythe_Godly" or itemID == "Reaver_Godly" or itemID ==
                    "Reaver_Ancient" or itemID == "IceHammer_Ancient" then
                    return
                end
                for _, item in ipairs(fakeYourOffer) do
                    if item.ItemID == itemID and item.ItemType == itemType then
                        item.Amount = (item.Amount or 1) + 1
                        refreshTradeDisplay()
                        startAcceptCooldown()
                        print("[MockTrade] You offered: " .. itemID .. " x" .. item.Amount)
                        return
                    end
                end
                if #fakeYourOffer >= 4 then
                    warn("[MockTrade] Your offer is full (4 slots).");
                    return
                end
                table.insert(fakeYourOffer, {
                    ItemID = itemID,
                    ItemType = itemType,
                    Amount = 1
                })
                refreshTradeDisplay()
                startAcceptCooldown()
                print("[MockTrade] You offered: " .. itemID .. " (" .. itemType .. ")")
                return
            elseif self == realRemoveOffer then
                return
            end
        end
    end
    return oldNamecall(self, ...)
end))

