local function getTemplateFrame()
    if cachedTemplate then
        return cachedTemplate
    end
    for _, child in pairs(LeaderboardContainer:GetChildren()) do
        if child:FindFirstChild("IsPlayerFrame") then
            cachedTemplate = child:Clone()
            return cachedTemplate
        end
    end
    local mainGUISource = ReplicatedStorage:FindFirstChild("MainGUI")
    if mainGUISource then
        local lbScript = mainGUISource:FindFirstChild("Inventory") and
                             mainGUISource.Inventory:FindFirstChild("Leaderboard")
        if lbScript then
            local template = lbScript:FindFirstChild("Player_Frame")
            if template then
                cachedTemplate = template:Clone()
                return cachedTemplate
            end
        end
    end
    return nil
end

local function sortLeaderboard()
    local frames = {}
    for _, child in pairs(LeaderboardContainer:GetChildren()) do
        if child:GetAttribute("IsFake") or child:FindFirstChild("IsPlayerFrame") then
            local prestige = child:GetAttribute("FakePrestige") or 0
            local level = child:GetAttribute("FakeLevel") or 1
            table.insert(frames, {
                Frame = child,
                Score = prestige * 100 + level
            })
        end
    end
    table.sort(frames, function(a, b)
        return a.Score > b.Score
    end)
    for i, data in ipairs(frames) do
        data.Frame.LayoutOrder = i
    end
end

local function addFakePlayer(name, level, prestige, isElite)
    if fakePlayerFrames[name] then
        warn("[MockTrade] Player '" .. name .. "' already exists.")
        return
    end
    local template = getTemplateFrame()
    if not template then
        warn("[MockTrade] No player frame template found.")
        return
    end
    local frame = cachedTemplate:Clone()
    frame.Name = "FAKE_" .. name
    if frame:FindFirstChild("IsPlayerFrame") then
        frame.IsPlayerFrame:Destroy()
    end

    local prefix = isElite and "[ELITE] " or ""
    frame.PlayerLabel.Text = prefix .. name
    frame.PlayerLabel.TextColor3 = isElite and Color3.fromRGB(232, 42, 42) or Color3.new(1, 1, 1)

    if frame:FindFirstChild("Level") then
        if frame.Level:FindFirstChild("Level") then
            frame.Level.Level.Text = tostring(level or 1)
        end
        if frame.Level:FindFirstChild("Prestige") then
            frame.Level.Prestige.Text = romanNumerals[prestige or 0] or ""
        end
    end
    if frame:FindFirstChild("XPBar") then
        frame.XPBar.Visible = false
    end

    frame:SetAttribute("FakePrestige", prestige or 0)
    frame:SetAttribute("FakeLevel", level or 1)
    frame:SetAttribute("IsFake", true)

    for _, child in pairs(LeaderboardContainer:GetChildren()) do
        if child:FindFirstChild("IsPlayerFrame") and not child:GetAttribute("IsFake") then
            if child:GetAttribute("FakePrestige") == nil then
                local pText = child:FindFirstChild("Level") and child.Level:FindFirstChild("Prestige") and
                                  child.Level.Prestige.Text or ""
                local lText = child:FindFirstChild("Level") and child.Level:FindFirstChild("Level") and
                                  child.Level.Level.Text or "1"
                local pVal = 0
                for num, roman in pairs(romanNumerals) do
                    if roman == pText then
                        pVal = num;
                        break
                    end
                end
                child:SetAttribute("FakePrestige", pVal)
                child:SetAttribute("FakeLevel", tonumber(lText) or 1)
            end
        end
    end

    frame.Visible = _G.LeaderboardOpen ~= false
    frame.Parent = LeaderboardContainer
    fakePlayerFrames[name] = frame
    fakePlayerCount = fakePlayerCount + 1

    if frame:FindFirstChild("ActionButton") then
        frame.ActionButton.Activated:Connect(function()
            local inspect = Leaderboard:FindFirstChild("Inspect")
            if inspect then
                inspect.Container.Username.Text = name
                inspect.Position = UDim2.new(inspect.Position.X, UDim.new(0, frame.AbsolutePosition.Y + 45))
                if inspect.Container:FindFirstChild("Trade") then
                    inspect.Container.Trade.Visible = true
                end
                if inspect.Container:FindFirstChild("Prestige") then
                    inspect.Container.Prestige.Visible = false
                end
                inspect.Visible = not inspect.Visible
            end
        end)
    end

    sortLeaderboard()
    print("[MockTrade] Added fake player: " .. name .. " (Lv " .. level .. ", Prestige " ..
              (romanNumerals[prestige or 0] or "0") .. ")")
end

local function removeFakePlayer(name)
    if fakePlayerFrames[name] then
        fakePlayerFrames[name]:Destroy()
        fakePlayerFrames[name] = nil
        fakePlayerCount = fakePlayerCount - 1
        sortLeaderboard()
    end
end

local function clearFakePlayers()
    for name, _ in pairs(fakePlayerFrames) do
        removeFakePlayer(name)
    end
end

