local DEFAULT_ITEMS = {
    DefaultKnife = true,
    DefaultGun = true,
}

local function resolveItem(itemID)
    if DEFAULT_ITEMS[itemID] then return nil end
    return values[itemID]
end

local function calculateInventoryValue(inventory)
    if not inventory then return 0 end
    local total = 0
    for category, catData in pairs(inventory) do
        if (category == "Weapons" or category == "Pets")
            and typeof(catData) == "table"
            and catData.Owned
        then
            for itemID, amount in pairs(catData.Owned) do
                local entry = resolveItem(itemID)
                if entry then
                    local amt = (typeof(amount) == "number") and amount or 1
                    total = total + (entry.value * amt)
                end
            end
        end
    end
    return total
end

local function formatValue(v)
    if v >= 1000000 then return string.format("%.2fM", v / 1000000) end
    if v >= 1000 then return string.format("%.1fk", v / 1000) end
    return tostring(v)
end

